<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ MIYO UI/UX Redesign - Extended Color Tokens
  ~ Ember palette: warm mango accent ramp, theme-aware via DayNight
  ~ alternatives in values-night/colors_miyo_ext.xml
-->
<resources>

        <!-- Extended brand accent ramp (subtle highlights, badges, gradients) -->
        <color name="miyo_accent">#FF8F42</color>
        <color name="miyo_accentContainer">#FFDCC2</color>
        <color name="miyo_onAccent">#2E1500</color>
        <color name="miyo_accentDim">#F0A268</color>

        <!-- Soft tonal surfaces for elevated cards (above surfaceContainer) -->
        <color name="miyo_surfaceElevated">#FFFFFF</color>
        <color name="miyo_surfaceOverlay">#33FF8F42</color>

        <!-- Gradient endpoints for backdrop scrim on details/reader -->
        <color name="miyo_scrim_top">#66000000</color>
        <color name="miyo_scrim_bottom">#E6000000</color>
        <color name="miyo_scrim_mid">#99000000</color>

        <!-- Section header accent (very subtle brand tint) -->
        <color name="miyo_sectionHeaderTint">#1A8C4A00</color>

        <!-- Status tints (semantic) -->
        <color name="miyo_status_reading">#8C4A00</color>
        <color name="miyo_status_planning">#7A5800</color>
        <color name="miyo_status_completed">#2E7D32</color>
        <color name="miyo_status_paused">#5C6BC0</color>
        <color name="miyo_status_dropped">#BA1B1B</color>

        <!-- Subtle divider (instead of solid outline) -->
        <color name="miyo_divider">#14000000</color>

        <!-- Chip tonal states (for filter chips) -->
        <color name="miyo_chip_selected_bg">#FFDCC2</color>
        <color name="miyo_chip_selected_fg">#2E1500</color>
        <color name="miyo_chip_unselected_bg">#F7EAE1</color>
        <color name="miyo_chip_unselected_fg">#52443A</color>

        <!-- Quick-action tile backgrounds (very subtle, theme-tinted) -->
        <color name="miyo_tile_bg_primary">#0F8C4A00</color>
        <color name="miyo_tile_bg_secondary">#0F765848</color>
        <color name="miyo_tile_bg_tertiary">#0F4C5226</color>
        <color name="miyo_tile_bg_neutral">#0F52443A</color>

        <!-- FAB shadow (subtle, brand-tinted) -->
        <color name="miyo_fab_shadow">#33FF8F42</color>

        <!-- Reading progress ring track (lighter than surfaceVariant) -->
        <color name="miyo_progress_track">#248C4A00</color>

        <!-- Empty state tints (theme-aware) -->
        <color name="miyo_empty_icon">#598C4A00</color>
        <color name="miyo_empty_icon_bg">#0F8C4A00</color>

</resources>
